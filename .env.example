# ============================================================================
# Materials Demo Teaching - Environment Template
# 复制为 .env 后再修改。推荐使用绝对路径。
# 更详细说明见 README.md 与 docs/配置与模型准备.md
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 必填：Materials Project API Key
# ----------------------------------------------------------------------------
MP_API_KEY=

# ----------------------------------------------------------------------------
# 2. 必填：主 Python 环境
# 默认情况下只需要填写这一项 Python 路径。
# FastAPI、materials-project MCP、material-agent-core MCP 都会默认复用它。
# ----------------------------------------------------------------------------
DEMO_APP_HOST=127.0.0.1
DEMO_APP_PORT=18018
DEMO_BACKEND_PYTHON=/abs/path/to/miniconda3/envs/materials-demo-teaching/bin/python

# ----------------------------------------------------------------------------
# 3. Materials Project MCP Server
# 默认不需要单独填写 Python；会自动继承 DEMO_BACKEND_PYTHON
# MATERIALS_PROJECT_WORKDIR 是这个 MCP 的运行缓存目录
# MATERIALS_PROJECT_CLEAR_PROXY=true 会在启动时清掉 HTTP(S)_PROXY，常用于规避 TLS 问题
# ----------------------------------------------------------------------------
MATERIALS_PROJECT_HOST=127.0.0.1
MATERIALS_PROJECT_PORT=18866
MATERIALS_PROJECT_WORKDIR=/abs/path/to/materials-demo-teaching/workdir/materials-project
MATERIALS_PROJECT_CLEAR_PROXY=true
MPLCONFIGDIR=/tmp/materials_demo_teaching_mplconfig
# 高级用法：只有需要单独拆环境时，才取消注释这一行
# MATERIALS_PROJECT_MCP_PYTHON=/abs/path/to/another/python

# ----------------------------------------------------------------------------
# 4. Material Agent Core MCP Server
# 默认不需要单独填写 Python；会自动继承 DEMO_BACKEND_PYTHON
# ----------------------------------------------------------------------------
MATERIAL_AGENT_CORE_HOST=127.0.0.1
MATERIAL_AGENT_CORE_PORT=18865
# 高级用法：只有需要单独拆环境时，才取消注释这一行
# MATERIAL_AGENT_CORE_MCP_PYTHON=/abs/path/to/another/python

# ----------------------------------------------------------------------------
# 5. 外部 material-agent 仓库与模型执行路径
# MATERIAL_AGENT_REPO_ROOT: material-agent 仓库根目录（里面应包含 material_agent/ 包）
# MATTERGEN_GENERATE_BIN: mattergen-generate 可执行文件
# MATTERSIM_PYTHON: 能 import mattersim 的 Python
# MATTERSIM_LOAD_PATH: MatterSim checkpoint(.pth) 绝对路径；启动脚本会直接检查文件是否存在
# MATTERSIM_DEVICE: 通常设为 cuda；没有 GPU 时改为 cpu
# 推荐环境收口为 3 套：
# 1) 本项目 conda 环境
# 2) MatterGen 环境
# 3) MatterSim 环境
# ----------------------------------------------------------------------------
MATERIAL_AGENT_REPO_ROOT=/abs/path/to/material-agent
MATTERGEN_GENERATE_BIN=/abs/path/to/mattergen/bin/mattergen-generate
MATTERSIM_PYTHON=/abs/path/to/mattersim/bin/python
MATTERSIM_LOAD_PATH=/abs/path/to/mattersim-v1.0.0-1M.pth
MATTERSIM_DEVICE=cuda

# ----------------------------------------------------------------------------
# 6. MCP 协议版本
# 一般无需修改，除非需要与其他组件统一 MCP 协议版本
# ----------------------------------------------------------------------------
MCP_PROTOCOL_VERSION=2025-11-25

# ----------------------------------------------------------------------------
# 7. 可选：LLM Router（OpenAI 兼容接口）
# 用于 decide_next_step 节点判断要不要执行“检索 / 生成 / 评估”
# 留空则自动回退到内置规则路由
# ----------------------------------------------------------------------------
LLM_ROUTER_BASE_URL=
LLM_ROUTER_API_KEY=
LLM_ROUTER_MODEL=
LLM_ROUTER_TIMEOUT_SECONDS=30
